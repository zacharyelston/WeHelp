{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wehelp.local/schemas/wehelp.form.v1.json",
  "title": "wehelp.form.v1 form definition",
  "description": "A WeHelp form definition (docs/QUESTIONNAIRES.md). This schema describes the shape. The reference validator (internal/forms, Go) also enforces what a JSON Schema can't: at most 200,000 UTF-8 bytes and 500 items; ids unique across sections, pages, items and scores; every reference resolves; rules look only at earlier items (earlier pages, or earlier on the same page; a section's next rules up to the end of that section); scores use only earlier scores; next only goes forward; expression trees at most 32 deep and 4,096 nodes in all; operand types (numbers, strings, booleans, dates, multiple-choice answers); string literals compared with a choice answer are option values; min <= max; bands in increasing order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "title", "sections"],
  "properties": {
    "format": { "const": "wehelp.form.v1" },
    "title": { "$ref": "#/$defs/text" },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "description": { "type": "string" },
    "code": { "$ref": "#/$defs/coding" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "scores": { "type": "array", "items": { "$ref": "#/$defs/score" } }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$",
      "not": { "const": "end" },
      "description": "Unique across the form's sections, pages, items and scores. \"end\" is reserved."
    },
    "text": { "type": "string", "minLength": 1 },
    "decimal": {
      "type": "number",
      "description": "A finite base-10 number with at most 12 integer and 6 fractional digits, written without an exponent (the validator checks the JSON text)."
    },
    "integer": { "type": "integer", "description": "A whole number, written without a fractional part or exponent." },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "A real calendar date, YYYY-MM-DD." },
    "dateBound": { "anyOf": [{ "$ref": "#/$defs/date" }, { "const": "today" }] },
    "coding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "code"],
      "properties": {
        "system": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/text" },
        "display": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pages"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
        "next": {
          "type": "array",
          "description": "The first entry whose when holds picks the next section. An entry without when is the default and must come last. With no match, the following section (or end).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section"],
            "properties": {
              "when": { "$ref": "#/$defs/expr" },
              "section": { "anyOf": [{ "$ref": "#/$defs/id" }, { "const": "end" }] }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "items": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "type"],
      "properties": { "type": { "enum": ["display", "choice", "boolean", "integer", "decimal", "date", "text"] } },
      "oneOf": [
        { "$ref": "#/$defs/displayItem" },
        { "$ref": "#/$defs/choiceItem" },
        { "$ref": "#/$defs/booleanItem" },
        { "$ref": "#/$defs/integerItem" },
        { "$ref": "#/$defs/decimalItem" },
        { "$ref": "#/$defs/dateItem" },
        { "$ref": "#/$defs/textItem" }
      ]
    },
    "displayItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "anyOf": [{ "required": ["text"] }, { "required": ["media"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "display" },
        "text": { "type": "string" },
        "code": { "$ref": "#/$defs/coding" },
        "required": { "const": false },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "control": { "not": {} },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "asset"],
          "properties": {
            "type": { "enum": ["image", "video"] },
            "asset": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$", "description": "An asset of this form version, never a URL." },
            "alt": { "type": "string" }
          }
        }
      }
    },
    "choiceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "choice" },
        "text": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/coding" },
        "required": { "type": "boolean" },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "control": { "enum": ["radio", "dropdown", "buttons"] },
        "multiple": { "type": "boolean" },
        "options": {
          "type": "array",
          "minItems": 1,
          "description": "Option values are unique within the item.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "text"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 64 },
              "text": { "$ref": "#/$defs/text" },
              "code": { "$ref": "#/$defs/coding" },
              "score": { "$ref": "#/$defs/decimal" }
            }
          }
        }
      }
    },
    "booleanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "boolean" },
        "text": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/coding" },
        "required": { "type": "boolean" },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "control": { "enum": ["toggle", "buttons"] }
      }
    },
    "integerItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "if": { "properties": { "control": { "const": "slider" } }, "required": ["control"] },
      "then": { "required": ["min", "max"] },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "integer" },
        "text": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/coding" },
        "required": { "type": "boolean" },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "control": { "enum": ["keypad", "slider"] },
        "min": { "$ref": "#/$defs/integer" },
        "max": { "$ref": "#/$defs/integer" },
        "step": { "$ref": "#/$defs/integer", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "minLabel": { "type": "string" },
        "maxLabel": { "type": "string" }
      }
    },
    "decimalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "if": { "properties": { "control": { "const": "slider" } }, "required": ["control"] },
      "then": { "required": ["min", "max"] },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "decimal" },
        "text": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/coding" },
        "required": { "type": "boolean" },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "control": { "enum": ["keypad", "slider"] },
        "min": { "$ref": "#/$defs/decimal" },
        "max": { "$ref": "#/$defs/decimal" },
        "step": { "$ref": "#/$defs/decimal", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "minLabel": { "type": "string" },
        "maxLabel": { "type": "string" }
      }
    },
    "dateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "date" },
        "text": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/coding" },
        "required": { "type": "boolean" },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "control": { "not": {} },
        "min": { "$ref": "#/$defs/dateBound" },
        "max": { "$ref": "#/$defs/dateBound" }
      }
    },
    "textItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "text" },
        "text": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/coding" },
        "required": { "type": "boolean" },
        "enableWhen": { "$ref": "#/$defs/expr" },
        "control": { "enum": ["long"] },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "Characters (Unicode code points). Default 4000." }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expr"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string" },
        "code": { "$ref": "#/$defs/coding" },
        "expr": { "$ref": "#/$defs/expr", "description": "Must evaluate to a number." },
        "showScore": { "type": "boolean" },
        "missing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "description": "Governs every sum in this score. null (default): a missing operand makes the sum null. zero: missing operands count as 0 (optional minAnswered). prorate: sum x operands / answered, then rounded half-even to places; minAnswered and places required.",
          "properties": {
            "policy": { "enum": ["null", "zero", "prorate"] },
            "minAnswered": { "type": "integer", "minimum": 1, "maximum": 500 },
            "places": { "type": "integer", "minimum": 0, "maximum": 6 }
          },
          "allOf": [
            { "if": { "properties": { "policy": { "const": "prorate" } } }, "then": { "required": ["minAnswered", "places"] } },
            { "if": { "properties": { "policy": { "const": "null" } } }, "then": { "not": { "anyOf": [{ "required": ["minAnswered"] }, { "required": ["places"] }] } } },
            { "if": { "properties": { "policy": { "const": "zero" } } }, "then": { "not": { "required": ["places"] } } }
          ]
        },
        "bands": {
          "type": "array",
          "description": "In increasing order of min. A value is in the last band whose min it reaches.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "id"],
            "properties": {
              "min": { "$ref": "#/$defs/decimal" },
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "exprList": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
    "itemRef": { "$ref": "#/$defs/id" },
    "expr": {
      "description": "One node of the closed expression tree: an object with exactly one operator key. Arithmetic (sum, add, sub, mul, div, count, round) is allowed only in scores.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        { "required": ["answer"], "properties": { "answer": { "$ref": "#/$defs/itemRef" } } },
        { "required": ["scoreOf"], "properties": { "scoreOf": { "$ref": "#/$defs/itemRef" } } },
        { "required": ["score"], "properties": { "score": { "$ref": "#/$defs/id" } } },
        { "required": ["num"], "properties": { "num": { "$ref": "#/$defs/decimal" } } },
        { "required": ["str"], "properties": { "str": { "type": "string" } } },
        { "required": ["bool"], "properties": { "bool": { "type": "boolean" } } },
        { "required": ["eq"], "properties": { "eq": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["ne"], "properties": { "ne": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["lt"], "properties": { "lt": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["le"], "properties": { "le": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["gt"], "properties": { "gt": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["ge"], "properties": { "ge": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["in"], "properties": { "in": { "$ref": "#/$defs/exprList", "minItems": 2, "description": "A subject, then literals (str, or num for a number subject)." } } },
        { "required": ["answered"], "properties": { "answered": { "$ref": "#/$defs/itemRef" } } },
        { "required": ["and"], "properties": { "and": { "$ref": "#/$defs/exprList", "minItems": 1 } } },
        { "required": ["or"], "properties": { "or": { "$ref": "#/$defs/exprList", "minItems": 1 } } },
        { "required": ["not"], "properties": { "not": { "$ref": "#/$defs/expr" } } },
        { "required": ["sum"], "properties": { "sum": { "$ref": "#/$defs/exprList", "minItems": 1 } } },
        { "required": ["add"], "properties": { "add": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["sub"], "properties": { "sub": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["mul"], "properties": { "mul": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["div"], "properties": { "div": { "$ref": "#/$defs/exprList", "minItems": 2, "maxItems": 2 } } },
        { "required": ["count"], "properties": { "count": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/itemRef" } } } },
        {
          "required": ["round"],
          "properties": {
            "round": {
              "type": "array",
              "prefixItems": [
                { "$ref": "#/$defs/expr" },
                { "type": "object", "additionalProperties": false, "required": ["num"], "properties": { "num": { "type": "integer", "minimum": 0, "maximum": 6 } } }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    }
  }
}
