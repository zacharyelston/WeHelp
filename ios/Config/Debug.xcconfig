// Debug build settings.
//
// The app reaches a Back Office only through its Relay, pinning both keys
// (#36). Demo practices are listed below; set your own in Local.xcconfig
// (gitignored; copy Local.xcconfig.example).

// Demo account shown on the sign-in screen (seed data from `make seed`,
// already public in the README). Release builds leave these empty.
WEHELP_DEV_TENANT = Demo Clinic
WEHELP_DEV_EMAIL = jordan.lee@demo.wehelp
WEHELP_DEV_PASSWORD = wehelp-demo-patient

// Demo practices, comma-separated, each
//   Label|relay host:port|relay pin|office ID|office pin
// Pins and the office ID come from `wehelp-relay init` and `wehelpd init`.
WEHELP_DEV_SERVERS =

#include? "Local.xcconfig"
