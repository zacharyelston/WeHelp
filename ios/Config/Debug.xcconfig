// Debug build settings. The default server URL suits the simulator, which
// shares the Mac's network. For a physical device, copy
// Local.xcconfig.example to Local.xcconfig (gitignored) and set your Mac's
// LAN address there.
WEHELP_DEFAULT_SERVER_URL = http:/$()/localhost:8080

// Demo connection shown on the sign-in screen (seed data from `make seed`,
// already public in the README). Release builds leave these empty.
WEHELP_DEV_TENANT = Demo Clinic
WEHELP_DEV_EMAIL = jordan.lee@demo.wehelp
WEHELP_DEV_PASSWORD = wehelp-demo-patient
// Demo servers as `Label|URL` pairs, comma-separated. Empty = one demo
// server at WEHELP_DEFAULT_SERVER_URL. Set your own in Local.xcconfig.
WEHELP_DEV_SERVERS =

#include? "Local.xcconfig"
